PORT=3002

# AI provider — switch by changing these two vars, no code changes needed
# Supported: openai, anthropic
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini          # or: claude-haiku-4-5-20251001, gpt-4o, claude-sonnet-4-6, etc.

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Supabase (required for session logging and word jar)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # Service role key — server only, never expose to client

# Phase 2+
DATABASE_URL=
REDIS_URL=
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
